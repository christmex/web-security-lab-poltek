<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Without the rewrite above, Apache would serve project files such as .env,
# composer.json and storage/logs directly. Refuse everything instead.
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
